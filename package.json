{
  "name": "production-planner",
  "private": true,
  "description": "Production Planner \u2013 developer tools only (the app itself has no build step).",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-production-planner \"node --test tests/\"",
    "practice": "firebase emulators:start --only auth,firestore --project demo-production-planner",
    "practice:seed": "node scripts/seed-practice.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.3.0"
  }
}
