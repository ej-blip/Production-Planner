rules_version = '2';

// =====================================================================
// Production Planner — Firestore security rules
//
// Paste into: Firebase console → Firestore Database → Rules → Publish.
//
// Sign-in uses PINs, not email:
//   • Each screen signs in anonymously (no account), then enters a PIN.
//   • There is one shared BENCH PIN and one longer MANAGEMENT PIN.
//   • PINs are stored as documents in pins/{pin} with a role. Screens can't
//     read that list; a PIN only works if a document with that exact ID exists.
//   • A screen that entered a PIN gets devices/{its id} = { role, pin }.
//     If that PIN is later changed or deleted, the screen loses access at once.
//
// Who can do what:
//   management  – full access: roster, work orders, plans, staff, PINs.
//   bench       – reads staff, colours, rosters and RELEASED plans. On a
//                 released plan it can move people, log changes, update
//                 the day's current target, set batch statuses on the floor
//                 board and pin notes (editing only notes a bench pinned).
//                 It never sees draft plans. It can read work orders but
//                 not change them. It moves job cards on (or back) as it
//                 finishes them and leaves a short remainder as its own card.
//   anyone else – no access.
//
// Data layout:
//   pins/{pin}                       role ('bench' | 'management')
//   devices/{uid}                    role, pin, createdAt
//   staff/{staffKey}                 Worker Admin settings
//   configPresets/{key}              configuration colours
//   lists/{name}                     the choices: units, customers, connectors,
//                                    comms, sims ({ items: [...] })
//   workOrders/{id}                  customer orders built over several days
//   customJobs/{id}                  saved names for other work (cleaning, stocktake)
//   extraJobs/{id}                   jobs that are just text, carried day to day
//                                    until marked done
//   jobs/{id}                        job cards: units of an order moving bench to
//                                    bench (assembly → testing → hardware →
//                                    packing → done), across days
//   rosters/{YYYY-MM-DD}             who is in on that day
//   plans/{YYYY-MM-DD}               build batches, status, targets, workflow
//   plans/{date}/assignments/{id}    who works where, per phase (id = phase_staffKey)
//   plans/{date}/events/{id}         changes made after release
//   plans/{date}/progress/{id}       floor board: each bench's status per batch
//                                    (id = bench_batchId)
//   plans/{date}/notes/{id}          floor board: pinned notes and photos
//   plans/{date}/requests/{id}       help, stock and faulty reports from
//                                    the benches
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function devicePath() {
      return /databases/$(database)/documents/devices/$(request.auth.uid);
    }

    function pinPath(pin) {
      return /databases/$(database)/documents/pins/$(pin);
    }

    function pinFormatOk(pin) {
      return pin is string && pin.matches('^[A-Za-z0-9 _-]{6,64}$');
    }

    // The screen's role, but only while its PIN still exists with that role.
    function role() {
      let device = signedIn() && exists(devicePath()) ? get(devicePath()).data : null;
      return device != null
          && pinFormatOk(device.pin)
          && exists(pinPath(device.pin))
          && get(pinPath(device.pin)).data.role == device.role
        ? device.role
        : '';
    }

    function isManagement() {
      return role() == 'management';
    }

    function isBench() {
      return role() == 'bench';
    }

    function isAppUser() {
      return isManagement() || isBench();
    }

    // ---------- Checks -------------------------------------------------
    // Entering a PIN: the role must match the PIN's role.
    function validDevice() {
      let d = request.resource.data;
      return d.keys().hasAll(['role', 'pin', 'createdAt'])
        && d.keys().hasOnly(['role', 'pin', 'createdAt'])
        && pinFormatOk(d.pin)
        && exists(pinPath(d.pin))
        && get(pinPath(d.pin)).data.role == d.role
        && d.createdAt == request.time;
    }

    // Management PIN at least 8 characters, bench PIN at least 6.
    function validPin(pin) {
      let d = request.resource.data;
      return pinFormatOk(pin)
        && d.keys().hasOnly(['role', 'updatedAt'])
        && ((d.role == 'management' && pin.size() >= 8) || d.role == 'bench');
    }

    function planIsReleased(date) {
      let plan = /databases/$(database)/documents/plans/$(date);
      return exists(plan) && get(plan).data.status == 'released';
    }

    // A bench may only change the current target (and its own limit) on a
    // released plan. benchLimits holds each bench's limit, e.g. { testing: 30 }.
    function benchTargetUpdate() {
      return resource.data.status == 'released'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['currentTarget', 'benchLimits', 'updatedAt', 'updatedBy'])
        && request.resource.data.currentTarget is int
        && request.resource.data.currentTarget >= 0
        && request.resource.data.get('benchLimits', {}) is map
        && request.resource.data.updatedAt == request.time;
    }

    // One job per person per phase: the document id must be "phase_staffKey".
    function validAssignment(assignmentId) {
      let d = request.resource.data;
      return d.keys().hasAll(['phase', 'station', 'staffKey', 'updatedAt'])
        && d.keys().hasOnly(['phase', 'station', 'jobLabel', 'batchId', 'staffKey', 'source', 'updatedBy', 'updatedAt'])
        && d.phase in ['start', 'second', 'finish']
        && d.station is string && d.station.size() > 0
        && d.staffKey is string && d.staffKey.size() > 0
        && assignmentId == d.phase + '_' + d.staffKey
        && d.updatedAt == request.time;
    }

    function validEvent() {
      let d = request.resource.data;
      return d.keys().hasAll(['bench', 'kind', 'createdAt'])
        && d.keys().hasOnly(['bench', 'kind', 'staffKey', 'message', 'targetBefore', 'targetAfter', 'createdBy', 'createdAt'])
        && d.kind in ['released', 'moved', 'removed', 'added', 'target_changed', 'note']
        && d.createdAt == request.time;
    }

    // A bench can't post as management or log a plan release.
    function benchEvent() {
      return request.resource.data.bench != 'management'
        && request.resource.data.kind != 'released';
    }

    // Floor board: one bench's status for one batch.
    function validProgress(progressId) {
      let d = request.resource.data;
      return d.keys().hasAll(['bench', 'batchId', 'status', 'updatedAt'])
        && d.keys().hasOnly(['bench', 'batchId', 'status', 'done', 'updatedBy', 'updatedAt'])
        && d.bench in ['cage', 'assembly', 'testing', 'hardware', 'packing']
        && d.batchId is string && d.batchId.size() > 0 && d.batchId.size() <= 64
        && progressId == d.bench + '_' + d.batchId
        && d.status in ['waiting', 'in_progress', 'hit', 'short']
        && (d.get('done', null) == null || (d.done is int && d.done >= 0 && d.done <= 100000))
        && d.updatedAt == request.time;
    }

    // Floor board: a pinned note (text and/or one shrunk JPEG photo).
    function validNote() {
      let d = request.resource.data;
      return d.keys().hasAll(['bench', 'text', 'role', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['bench', 'text', 'photo', 'role', 'createdBy', 'createdAt', 'updatedAt'])
        && d.bench in ['all', 'cage', 'assembly', 'testing', 'hardware', 'packing']
        && d.text is string && d.text.size() <= 2000
        && (d.get('photo', null) == null
            || (d.photo is string && d.photo.size() <= 900000 && d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && d.role == role()
        && d.updatedAt == request.time;
    }

    // A request from a bench: help, stock or a faulty report.
    // status: open → accepted → done (e.g. stock: waiting → sent → received).
    function validRequest() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind', 'bench', 'status', 'text', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['kind', 'bench', 'status', 'text', 'qty', 'unit', 'batchId', 'photo', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.kind in ['help', 'stock', 'faulty']
        && d.bench in ['cage', 'assembly', 'testing', 'hardware', 'packing', 'management']
        && d.status in ['open', 'accepted', 'done']
        && d.text is string && d.text.size() <= 500
        && (d.get('qty', null) == null || (d.qty is int && d.qty > 0 && d.qty <= 100000))
        && (d.get('unit', null) == null || (d.unit is string && d.unit.size() <= 60))
        && (d.get('batchId', null) == null || (d.batchId is string && d.batchId.size() <= 64))
        && (d.get('photo', null) == null
            || (d.photo is string && d.photo.size() <= 900000 && d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && d.updatedAt == request.time;
    }

    // The unit and comms items from the lists (optional: older records
    // only have the built-in unitType / commsType).
    function listKeys(d) {
      return (d.get('unitKey', null) == null || (d.unitKey is string && d.unitKey.size() > 0 && d.unitKey.size() <= 40))
        && (d.get('commsKey', null) == null || (d.commsKey is string && d.commsKey.size() > 0 && d.commsKey.size() <= 40));
    }

    // A list of choices: unit types, customers, connectors, comms or SIM types.
    function validList() {
      let d = request.resource.data;
      return d.keys().hasAll(['items', 'updatedAt'])
        && d.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && d.items is list && d.items.size() <= 300
        && d.updatedAt == request.time;
    }

    // A customer order: what to build and how many in total. Days take
    // their batches from it until it is used up.
    function validWorkOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['customer', 'unitType', 'commsType', 'simType', 'configKey', 'quantity', 'status', 'updatedAt'])
        && d.keys().hasOnly(['customer', 'unitType', 'unitKey', 'commsType', 'commsKey', 'simType', 'connectorKey', 'configKey', 'configText', 'quantity', 'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && (d.get('connectorKey', null) == null || (d.connectorKey is string && d.connectorKey.size() <= 40))
        && d.customer is string && d.customer.size() > 0 && d.customer.size() <= 80
        && d.unitType in ['gen4', 'tap']
        && d.commsType in ['verizon', 'global']
        && listKeys(d)
        && d.simType is string && d.simType.size() <= 40
        && d.configKey is string && d.configKey.size() <= 40
        && (d.get('configText', null) == null || (d.configText is string && d.configText.size() <= 2000))
        && d.quantity is int && d.quantity > 0 && d.quantity <= 100000
        && d.status in ['open', 'closed']
        && d.updatedAt == request.time;
    }

    // A job that is just text ("Test one Solar PCB and send to Western
    // Power"), carried from day to day until it is marked done.
    function validExtraJob() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'status', 'updatedAt'])
        && d.keys().hasOnly(['title', 'status', 'doneDay', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['open', 'done']
        && (d.get('doneDay', null) == null || (d.doneDay is string && d.doneDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.updatedAt == request.time;
    }

    // A bench marks an open extra job done, and changes nothing else.
    function benchExtraJobDone() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'done'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneDay', 'updatedAt', 'updatedBy']);
    }

    // A saved name for other work people can be put on (cleaning, stocktake).
    function validCustomJob() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'updatedAt'])
        && d.keys().hasOnly(['name', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.updatedAt == request.time;
    }

    // A job card: some units of an order on their way through the benches.
    function validJob() {
      let d = request.resource.data;
      return d.keys().hasAll(['customer', 'unitType', 'commsType', 'simType', 'configKey', 'quantity', 'stage', 'day', 'updatedAt'])
        && d.keys().hasOnly(['orderId', 'customer', 'unitType', 'unitKey', 'commsType', 'commsKey', 'simType', 'connectorKey', 'configKey', 'configText', 'quantity', 'stage', 'day', 'parentId', 'doneDay', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && (d.get('connectorKey', null) == null || (d.connectorKey is string && d.connectorKey.size() <= 40))
        && d.customer is string && d.customer.size() > 0 && d.customer.size() <= 80
        && d.unitType in ['gen4', 'tap']
        && d.commsType in ['verizon', 'global']
        && listKeys(d)
        && d.simType is string && d.simType.size() <= 40
        && d.configKey is string && d.configKey.size() <= 40
        && (d.get('configText', null) == null || (d.configText is string && d.configText.size() <= 2000))
        && (d.get('orderId', null) == null || (d.orderId is string && d.orderId.size() <= 64))
        && (d.get('parentId', null) == null || (d.parentId is string && d.parentId.size() <= 120))
        && d.quantity is int && d.quantity > 0 && d.quantity <= 100000
        && d.stage in ['assembly', 'testing', 'hardware', 'packing', 'done']
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.get('doneDay', null) == null || (d.doneDay is string && d.doneDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.updatedAt == request.time;
    }

    // A bench moves a card on (or back) and records how many units went.
    function benchJobUpdate() {
      return validJob()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'quantity', 'doneDay', 'updatedAt', 'updatedBy']);
    }

    // A bench that finished short leaves the rest behind as its own card.
    function benchJobSplit() {
      return validJob()
        && request.resource.data.get('parentId', null) != null
        && request.resource.data.stage != 'done'
        && request.resource.data.get('doneDay', null) == null;
    }

    // ---------- PINs and signed-in screens -----------------------------
    match /pins/{pin} {
      allow read, delete: if isManagement();
      allow create, update: if isManagement() && validPin(pin);
    }

    match /devices/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManagement());
      allow create, update: if signedIn() && request.auth.uid == uid && validDevice();
      allow delete: if signedIn() && (request.auth.uid == uid || isManagement());
    }

    // ---------- Reference data -----------------------------------------
    match /staff/{staffKey} {
      allow read: if isAppUser();
      allow write: if isManagement();
    }

    match /configPresets/{presetKey} {
      allow read: if isAppUser();
      allow write: if isManagement();
    }

    match /lists/{listName} {
      allow read: if isAppUser();
      allow write: if isManagement()
        && listName in ['units', 'customers', 'connectors', 'comms', 'sims']
        && validList();
    }

    match /rosters/{date} {
      allow read: if isAppUser();
      allow write: if isManagement();
    }

    match /workOrders/{orderId} {
      allow read: if isAppUser();
      allow create, update: if isManagement() && validWorkOrder();
      allow delete: if isManagement();
    }

    match /extraJobs/{extraJobId} {
      allow read: if isAppUser();
      allow create: if isManagement() && validExtraJob();
      allow update: if validExtraJob() && (isManagement() || (isBench() && benchExtraJobDone()));
      allow delete: if isManagement();
    }

    match /customJobs/{customJobId} {
      allow read: if isAppUser();
      allow create, update: if isManagement() && validCustomJob();
      allow delete: if isManagement();
    }

    match /jobs/{jobId} {
      allow read: if isAppUser();
      allow create: if (isManagement() && validJob()) || (isBench() && benchJobSplit());
      allow update: if (isManagement() && validJob()) || (isBench() && benchJobUpdate());
      allow delete: if isManagement() || (isBench() && resource.data.get('parentId', null) != null);
    }

    // ---------- Daily plans --------------------------------------------
    match /plans/{date} {
      allow read: if isManagement() || (isBench() && resource.data.status == 'released');
      allow create, delete: if isManagement();
      allow update: if isManagement() || (isBench() && benchTargetUpdate());

      match /assignments/{assignmentId} {
        allow read: if isManagement() || (isBench() && planIsReleased(date));
        allow create, update: if isManagement()
          || (isBench() && planIsReleased(date) && validAssignment(assignmentId));
        allow delete: if isManagement() || (isBench() && planIsReleased(date));
      }

      match /progress/{progressId} {
        allow read: if isManagement() || (isBench() && planIsReleased(date));
        allow create, update: if validProgress(progressId)
          && (isManagement() || (isBench() && planIsReleased(date)));
        allow delete: if isManagement();
      }

      match /notes/{noteId} {
        allow read: if isManagement() || (isBench() && planIsReleased(date));
        allow create: if validNote()
          && request.resource.data.createdAt == request.time
          && (isManagement() || (isBench() && planIsReleased(date)));
        // Benches can change or remove only notes a bench pinned.
        allow update: if validNote()
          && request.resource.data.createdAt == resource.data.createdAt
          && (isManagement() || (isBench() && planIsReleased(date) && resource.data.role == 'bench'));
        allow delete: if isManagement()
          || (isBench() && planIsReleased(date) && resource.data.role == 'bench');
      }

      match /requests/{requestId} {
        allow read: if isManagement() || (isBench() && planIsReleased(date));
        allow create: if validRequest()
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && (isManagement() || (isBench() && planIsReleased(date)));
        // Moving a request along changes only its status.
        allow update: if (isManagement() || (isBench() && planIsReleased(date)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in ['open', 'accepted', 'done']
          && request.resource.data.updatedAt == request.time;
        allow delete: if isManagement();
      }

      match /events/{eventId} {
        allow read: if isManagement() || (isBench() && planIsReleased(date));
        allow create: if validEvent()
          && (isManagement() || (isBench() && planIsReleased(date) && benchEvent()));
        allow update, delete: if isManagement();
      }
    }
  }
}
